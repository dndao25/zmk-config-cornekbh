#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define NAV 1
#define SYM 2
#define ADJ 3
#define EXTRA 4

&msc {
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>; /* tune to taste */
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    macros {
        browsertab: browsertab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LCTRL>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <13 29>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <15 21>;
        };

        perc {
            bindings = <&kp PERCENT>;
            key-positions = <5 17>;
            layers = <0>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <28 16>;
            layers = <0>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <4 16>;
            layers = <0>;
        };

        pound {
            bindings = <&kp POUND>;
            key-positions = <3 15>;
            layers = <0>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <2 14>;
            layers = <0>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <26 14>;
            layers = <0>;
        };

        star {
            bindings = <&kp STAR>;
            key-positions = <8 20>;
            layers = <0>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <32 20>;
            layers = <0>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <7 19>;
            layers = <0>;
        };

        minus {
            bindings = <&kp KP_MINUS>;
            key-positions = <31 19>;
            layers = <0>;
        };

        underscore {
            bindings = <&kp UNDER>;
            key-positions = <30 18>;
            layers = <0>;
        };

        leftbrack {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <31 32>;
            layers = <0>;
        };

        rightbrack {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <33 32>;
            layers = <0>;
        };

        ctrlc {
            bindings = <&kp LG(C)>;
            key-positions = <14 27>;
        };

        paste {
            bindings = <&kp LG(V)>;
            key-positions = <14 28>;
        };

        selectall {
            bindings = <&kp LG(A)>;
            key-positions = <14 13>;
        };

        ctrlz {
            bindings = <&kp LG(Z)>;
            key-positions = <14 25>;
        };

        scrollup {
            bindings = <&msc SCRL_UP>;
            key-positions = <5 17>;
        };

        scrolldown {
            bindings = <&msc SCRL_DOWN>;
            key-positions = <17 29>;
        };

        homerowshift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <16 15>;
        };

        leftn {
            bindings = <&mo 2>;
            key-positions = <15 14>;
        };

        rightn {
            bindings = <&mo 3>;
            key-positions = <21 20>;
        };

        rshift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <20 19>;
        };
    };

    //

    keymap {
        compatible = "zmk,keymap";

        DEF {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp E     &kp R     &kp T        &kp Y    &kp U          &kp I         &kp O    &kp P     &kp BACKSPACE
&kp TAB     &kp A  &kp S  &kp D     &kp F     &kp G        &kp H    &kp J          &kp K         &kp L    &kp SEMI  &kp SQT
&mo 5       &kp Z  &kp X  &kp C     &kp V     &kp B        &kp N    &kp M          &kp COMMA     &kp DOT  &kp FSLH  &mo 0
                          &kp LGUI  &mkp MB1  &kp SPACE    &kp RET  &kp BACKSPACE  &kp LEFT_ALT
            >;
        };

        ADJ {
            display-name = "System";
            bindings = <
&trans          &kp F1        &kp F2      &kp F3      &kp F4      &kp F5            &kp F6  &kp F7  &kp F8  &kp F9  &kp F10      &trans
&studio_unlock  &kp F11       &trans      &trans      &trans      &studio_unlock    &trans  &trans  &trans  &trans  &trans       &trans
&trans          &bt BT_SEL 0  &bt BT_PRV  &bt BT_NXT  &bt BT_CLR  &bt BT_CLR_ALL    &trans  &trans  &trans  &trans  &bootloader  &trans
                                          &trans      &trans      &trans            &trans  &trans  &trans
            >;
        };

        leftnum {
            bindings = <
&kp LS(TILDE)  &kp LS(EXCL)  &kp LS(AT)  &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)    &trans  &trans  &trans  &trans  &trans  &trans
&kp GRAVE      &kp N1        &kp N2      &kp N3         &kp N4        &kp N5           &trans  &trans  &trans  &trans  &trans  &trans
&trans         &trans        &trans      &trans         &trans        &trans           &trans  &trans  &trans  &trans  &trans  &trans
                                         &trans         &trans        &trans           &trans  &trans  &trans
            >;
        };

        rightnum {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)  &kp LS(LPAR)  &kp LS(RPAR)  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp N6         &kp N7        &kp N8        &kp N9        &kp N0        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans         &trans        &trans        &trans        &trans        &trans
                        &trans  &trans  &trans    &trans         &trans        &trans
            >;
        };

        numpad {
            bindings = <
&trans  &trans  &kp N7  &kp N8  &kp N9  &trans    &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &trans  &kp N4  &kp N5  &kp N6  &trans    &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &kp N1  &kp N2  &kp N3  &trans    &trans  &kp N1  &kp N2  &kp N3  &trans  &trans
                        &kp N0  &trans  &trans    &trans  &trans  &kp N0
            >;
        };

        direction {
            bindings = <
&trans  &trans  &trans    &kp UP_ARROW    &trans     &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans          &trans     &trans    &trans  &trans  &trans  &trans  &trans  &trans
                          &trans          &trans     &trans    &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <2 3>;
            then-layer = <1>;
        };
    };
};
